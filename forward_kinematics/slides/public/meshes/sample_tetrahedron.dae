    <up_axis>Y_UP</up_axis>
  </asset>
  <library_geometries>
    <geometry id="tetra-geom" name="tetra">
      <mesh>
        <source id="tetra-positions">
          <float_array id="tetra-positions-array" count="12">
            0 0 0
            1 0 0
            0.5 0 0.866
            0.5 0.816 0.289
          </float_array>
          <technique_common>
            <accessor source="#tetra-positions-array" count="4" stride="3">
              <param name="X" type="float"/>
              <param name="Y" type="float"/>
              <param name="Z" type="float"/>
            </accessor>
          </technique_common>
        </source>
        <vertices id="tetra-vertices">
          <input semantic="POSITION" source="#tetra-positions"/>
        </vertices>
        <triangles count="4">
          <input semantic="VERTEX" source="#tetra-vertices" offset="0"/>
          <p>0 1 2 0 3 1 1 3 2 2 3 0</p>
        </triangles>
      </mesh>
    </geometry>
  </library_geometries>
  <library_visual_scenes>
    <visual_scene id="Scene" name="Scene">
      <node id="tetra" name="tetra">
        <instance_geometry url="#tetra-geom"/>
      </node>
